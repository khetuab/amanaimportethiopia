  "guide.channelTelegram": "ቴሌግራም",
  "guide.channelWebsite": "ድረ-ገጽ",
  "guide.buyer.step1.title": "ጥያቄዎን ያቅርቡ",
  "guide.buyer.step1.body": "የሚመጣውን ይግለጹ — ፎቶ፣ በጀት እና የማድረስ ከተማ። የትልክ ቃላት አያስፈልጉም፤ የተረጋገጡ አስመጪዎች ቀሪውን ያውቃሉ።",
  "guide.buyer.step1.p1": "ግሉጥ ፎቶዎች እና ትክክለኛ ልኬቶች ያክሉ",
  "guide.buyer.step1.p2": "ውነተኛ የበጀት ክልል ያስቀምጡ",
  "guide.buyer.step1.p3": "ዕቃው የሚደርስበትን ከተማ ይምረጡ",
  "guide.buyer.step2.title": "አስመጪዎች ይጠቅሳሉ",
  "guide.buyer.step2.body": "የተፈቀደላቸው አስመጪዎች የተከፋፈሉ ጥቅሶችን ያቀርባሉ — የአንድ ክፍል ዋጋ፣ የማድረስ ጊዜ እና ዋስትና — ስለዚህ እያንዳንዱ አቅርቦት ሊወዳደር ይችላል።",
  "guide.buyer.step2.p1": "የተረጋገጡ አስመጪዎች ብቻ ይጠቅሳሉ",
  "guide.buyer.step2.p2": "ጥቅሶች የተከፋፈሉ እና ግሉጥ ናቸው",
  "guide.buyer.step2.p3": "ጥያቄዎችን በውስጣዊ ውይይት ይጠይቁ",
  "guide.buyer.step3.title": "አወዳድረው እና ተቀበሉ",
  "guide.buyer.step3.body": "ጥቅሶቹን ጎን ለጎን አስቀምጡ። በተወለደው ዋጋ ሁልጊዜ ምርጥ አይደለም — የማድረስ ጊዜ፣ ዋስትና እና ደረጃ ልክ ብለው ይቀበሉ።",
  "guide.buyer.step3.p1": "ዋጋ፣ ዋስትና እና የማድረስ ጊዜ ያወዳድሩ",
  "guide.buyer.step3.p2": "መቀበል ሁለቱንም ያጠቃልላል",
  "guide.buyer.step3.p3": "እያንዳንዱን ውል በመተግበሪያው ውስጥ ያቆዩ",
  "guide.buyer.step4.title": "በጥበቃ ይክፈሉ",
  "guide.buyer.step4.body": "በመተግበሪያው ውስጥ ያሉትን የክፍያ መመሪያዎች ይከተሉ እና ማስረጃዎን ያስገቡ። አስመጪው ምንም ከመላኩ በፊት ቡድናችን ክፍያውን ያረጋግጣል።",
  "guide.buyer.step4.p1": "የክፍያ ማስረጃ በመተግበሪያው ያስገቡ",
  "guide.buyer.step4.p2": "እያንዳንዱ ክፍያ በቡድናችን ይገመገማል",
  "guide.buyer.step4.p3": "አስመጪዎች ከመጽደቁ በኋላ ብቻ ይላካሉ",
  "guide.buyer.step5.title": "እስከ በርዎ ይከታተሉ",
  "guide.buyer.step5.body": "ከዳህላ እስከ በር እያንዳንዱን የሁኔታ ማዘመን ይከታተሉ። ማድረሱን ያረጋግጡ፣ ለመተግበሪያው ገበያ የሚረዳ ግምገማ ይተዉ።",
  "guide.buyer.step5.p1": "በእያንዳንዱ ትልክ የቅጥይት ሁኔታ",
  "guide.buyer.step5.p2": "ትዕዛዙን ለማጠናቀቅ ማድረሱን አረጋግጥ",
  "guide.buyer.step5.p3": "ግምገማዎ የአስመጪ ደረጃዎችን ያደርጋል",
  "guide.buyer.finale.title": "ማምጣት ሊጀምሩ ዝግጁ ነዎት",
  "guide.buyer.finale.subtitle": "ጥያቄ ያቅርቡ፣ የተረጋገጡ አስመጪዎች እንዲወዳደሩ ፍተሻ ያድርጉ። ሙሉ ሐሳቡ ይኸውነው — እርስዎ ይግለጹ፣ እነሱ ያድርሉ።",
  "guide.importer.step1.title": "መጀመሪያ ይረጋገጡ",
  "guide.importer.step1.body": "የንግድ ፍቃድዎን በማረጋገጫ ያስገቡ። ከጸደቀ በኋላ በመገለጫዎ እና በሚልኳቸው እያንዳንዱ ጥቅስ ላይ የተረጋገጠ ምልክት ይታያል።",
  "guide.importer.step1.p1": "ትክክለኛ የንግድ ፍቃድ ያስገቡ",
  "guide.importer.step1.p2": "በቡድናችን በፍጥነት ይገመገማል",
  "guide.importer.step1.p3": "ምልክቱ ገዢዎች እንዲያምኑዎት ያደርጋል",
  "guide.importer.step2.title": "መገለጫዎን ያዘጋጁ",
  "guide.importer.step2.body": "ሙሉ የንግድ መገለጫ ትዕዛዞችን ያሸንፋል። የኩባንያዎን ዝርዝር እና በተሻለ ሁኔታ የሚመጡትን ምድቦች ያክሉ፣ የተዘመኑ እንዲሆኑ ያድርጉ።",
  "guide.importer.step2.p1": "ትክክለኛ የኩባንያ ዝርዝር ያክሉ",
  "guide.importer.step2.p2": "በተሻለ ሁኔታ የሚመጡትን ምድቦች ይምረጡ",
  "guide.importer.step2.p3": "ሙሉ መገለጫዎች ብዙ ጥያቄዎች ያገኛሉ",
  "guide.importer.step3.title": "ክፍት ጥያቄዎችን ያስሱ",
  "guide.importer.step3.body": "አዲስ የማምጣት ጥያቄዎች በየቀኑ ይደርሳሉ። በምድብ እና በከተማ ያጣሩ፣ መስፈርቶቹን በትክክል ያንብቡ፣ ማድረስ የሚችሉትን ይጠቅሱ።",
  "guide.importer.step3.p1": "ጥያቄዎችን በምድብ እና በከተማ ያጣሩ",
  "guide.importer.step3.p2": "አዲስ ጥያቄዎች በየቀኑ ይደርሳሉ",
  "guide.importer.step3.p3": "ጥቅስ ከመላክዎ በፊት ልኬቶቹን እና በጀቱን ያረጋግጡ",
  "guide.importer.step4.title": "ለማሸነፍ ይጠቅሱ",
  "guide.importer.step4.body": "ግሉጥ፣ የተከፋፈሉ ጥቅሶችን በቅርቡ ይላኩ። ዋጋዎን፣ የማድረስ ጊዜዎን እና ዋስትናዎን ይግለጹ — ፈጣን፣ ትክክለኛ ጥቅሶች ትዕዛዙን ያሸንፋሉ።",
  "guide.importer.step4.p1": "የእያንዳንዱን እቃ በግሉጥ ያስቀምጡ",
  "guide.importer.step4.p2": "ውነተኛ የማድረስ ጊዜ ይስጡ",
  "guide.importer.step4.p3": "ፈጣን፣ ትክክለኛ ጥቅሶች ይለያያሉ",
  "guide.importer.step5.title": "አሟልተው ወስደው ያድጉ",
  "guide.importer.step5.body": "የትዕዛዙን ሁኔታ እንደሚመጡ ያዘምኑ እና እየተላኩ መከታተል ያጋሩ። ገዢው ማድረሱን ከሚያረጋግጥ በኋላ ዝናዎ ቀጥሎ ያድጋል።",
